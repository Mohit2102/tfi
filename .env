# Only if the website is hosted on a different origin than this server,
# e.g. https://tfiindia.com  (also set API_BASE in the page)
ALLOWED_ORIGIN=

# Optional: serve the website files from this server (folder with the .html files)
STATIC_DIR=..

PORT=3000
