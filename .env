# Razorpay Dashboard -> Account & Settings -> API Keys
# Use rzp_test_... keys first, switch to rzp_live_... when going live
RAZORPAY_KEY_ID=rzp_live_TqqyC8hsSy3a6F
RAZORPAY_KEY_SECRET=0f3av0pO3rxZFhoMghWOnLr7

# Razorpay Dashboard -> Webhooks (event: order.paid). Any secret string you choose.
